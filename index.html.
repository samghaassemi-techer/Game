<!DOCTYPE html>
<html lang="fa" dir="rtl"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>بازی آوا</title>
<link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@500;800&display=swap" rel="stylesheet">
<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;font-family:Vazirmatn,Tahoma,sans-serif;color:#3b1f6b}
body{background:linear-gradient(135deg,#ff9ad5,#ffd36e,#7ee8fa,#b8a1ff);background-size:400% 400%;animation:bg 12s ease infinite;overflow-x:hidden}
@keyframes bg{50%{background-position:100% 100%}}
.bub{position:fixed;bottom:-60px;font-size:34px;animation:up 9s linear infinite;opacity:.6;pointer-events:none}
@keyframes up{to{transform:translateY(-120vh) rotate(360deg)}}
#app{max-width:480px;margin:0 auto;padding:16px;text-align:center;position:relative}
h1{margin:10px 0;font-size:30px;text-shadow:0 3px #fff}
.card{background:#fffc;border-radius:28px;padding:18px;box-shadow:0 8px 0 #0002}
.main{font-size:110px;animation:bounce 1.2s ease-in-out infinite;display:inline-block}
.main.w{animation:wig 1s ease-in-out infinite}
@keyframes bounce{50%{transform:translateY(-18px) scale(1.1)}}
@keyframes wig{25%{transform:rotate(-10deg)}75%{transform:rotate(10deg)}}
@keyframes flo{50%{transform:translateY(-8px)}}
.name{font-size:28px;font-weight:800}
.q{font-size:18px;margin:6px 0}
.opts{display:flex;gap:10px;margin-top:14px}
.opt{flex:1;background:#fff;border:4px solid #ffb3e1;border-radius:22px;padding:10px 4px;font:inherit;font-size:18px;font-weight:800;color:#3b1f6b;cursor:pointer;box-shadow:0 5px 0 #0002}
.opt span{display:block;font-size:50px;animation:flo 1.5s ease-in-out infinite}
.opt:nth-child(2) span{animation-delay:.3s}.opt:nth-child(3) span{animation-delay:.6s}
.opt.ok{background:#9bf5a8;border-color:#2ecc71}.opt.no{background:#ffb0b0;border-color:#e74c3c;animation:wig .4s}
.btn{margin-top:14px;background:#ff5fa8;color:#fff;border:0;border-radius:24px;padding:12px 34px;font:inherit;font-size:22px;font-weight:800;box-shadow:0 6px 0 #c23a82;cursor:pointer}
.circ{display:flex;gap:10px;justify-content:center;margin-top:14px}
.c{width:52px;height:52px;border-radius:50%;border:4px dashed #8e5bd6;background:#fff;cursor:pointer;transition:.2s}
.c.on{background:radial-gradient(circle at 30% 30%,#fff7,#ff4f9a 60%);border:4px solid #ff4f9a;transform:scale(1.15)}
.bar{display:flex;justify-content:space-between;font-weight:800;margin-bottom:10px}
.msg{min-height:34px;font-size:24px;font-weight:800;margin-top:10px}
.cf{position:fixed;top:-20px;font-size:28px;animation:fall 2s linear forwards;pointer-events:none}
@keyframes fall{to{transform:translateY(110vh) rotate(540deg)}}
.stars{font-size:70px}
</style></head><body>
<div id="app"></div>
<script>
const B=document.body;
"🎈⭐🌈🦋🍭☁️".split(/(?:)/u).forEach((e,i)=>{const d=document.createElement('div');d.className='bub';d.textContent=e;d.style.left=(i*17+4)+'%';d.style.animationDelay=(i*1.5)+'s';B.appendChild(d)});
const S1=[
{p:'🍎',n:'سیب',o:[['🪨','سنگ'],['🌹','گل'],['🐟','ماهی']],a:0},
{p:'🐟',n:'ماهی',o:[['🌙','ماه'],['🎩','کلاه'],['🌳','درخت']],a:0},
{p:'🐻',n:'خرس',o:[['🏠','خانه'],['⚽','توپ'],['🍌','موز']],a:0},
{p:'⚽',n:'توپ',o:[['🛏️','تخت'],['🍌','موز'],['🌹','گل']],a:0},
{p:'🌹',n:'گل',o:[['🐄','گاو'],['🚗','ماشین'],['🎩','کلاه']],a:0}];
const S2=[
{p:'🎩',n:'کلاه',o:[['🌙','ماه'],['🌳','درخت'],['⚽','توپ']],a:0},
{p:'🌳',n:'درخت',o:[['🛏️','تخت'],['🚗','ماشین'],['🌹','گل']],a:0},
{p:'🚗',n:'ماشین',o:[['🐄','گاو'],['🌍','زمین'],['⚽','توپ']],a:1},
{p:'🌹',n:'گل',o:[['🚗','ماشین'],['🎩','کلاه'],['❤️','دل']],a:2},
{p:'🏠',n:'خانه',o:[['⚽','توپ'],['🌱','دانه'],['🌹','گل']],a:1}];
const S3=[
{p:'🌹',n:'گل',k:1},{p:'🚗',n:'ماشین',k:2},{p:'🦋',n:'پروانه',k:3},{p:'✈️',n:'هواپیما',k:4},{p:'🏫',n:'مدرسه',k:3}];
let st=0,i=0,score=0,lock=false,A=document.getElementById('app');
const sh=a=>a.map(x=>[Math.random(),x]).sort((x,y)=>x[0]-y[0]).map(x=>x[1]);
const T=['🌟 هم‌آغاز','🎯 هم‌پایان','🔵 بخش‌کردن'];
function home(){A.innerHTML=`<h1>🎉 بازی آوا 🎉</h1><div class="card"><div class="main">🦄</div><p class="name">سه مرحله بازی!</p><p class="q">۱) هم‌آغاز ۲) هم‌پایان ۳) بخش‌کردن</p><button class="btn" onclick="go(0)">شروع ▶</button></div>`}
function go(s){st=s;i=0;score=0;show()}
function bar(){return `<div class="bar"><span>${T[st]}</span><span>سؤال ${i+1}/5</span><span>⭐ ${score}</span></div>`}
function show(){lock=false;
 if(st<2){const d=(st?S2:S1)[i];
  const q=st?'کدام کلمه با این تصویر هم‌پایان است؟':'کدام تصویر با این تصویر هم‌آغاز است؟';
  const os=sh(d.o.map((o,k)=>[o,k==d.a]));
  A.innerHTML=`<h1>${T[st]}</h1><div class="card">${bar()}<div class="main">${d.p}</div><div class="name">${d.n}</div><p class="q">${q}</p><div class="opts">${os.map((x,k)=>`<button class="opt" data-c="${x[1]?1:0}" onclick="pick(this)"><span>${x[0][0]}</span>${x[0][1]}</button>`).join('')}</div><div class="msg" id="m"></div></div>`;
 }else{const d=S3[i];
  A.innerHTML=`<h1>${T[2]}</h1><div class="card">${bar()}<div class="main w">${d.p}</div><div class="name">${d.n}</div><p class="q">کلمه چند بخش دارد؟ دایره‌ها را رنگ کن!</p><div class="circ">${[0,1,2,3,4].map(()=>`<div class="c" onclick="this.classList.toggle('on')"></div>`).join('')}</div><button class="btn" onclick="chk()">بررسی ✔️</button><div class="msg" id="m"></div></div>`;}
}
function conf(){for(let k=0;k<24;k++){const c=document.createElement('div');c.className='cf';c.textContent='🎉⭐🎈💖🌈'[k%5*1===k%5?0:0]||'🎉';c.textContent=['🎉','⭐','🎈','💖','🌈'][k%5];c.style.left=Math.random()*95+'%';c.style.animationDelay=Math.random()*.6+'s';B.appendChild(c);setTimeout(()=>c.remove(),2800)}}
function done(ok){const m=document.getElementById('m');
 if(ok){score++;m.textContent='آفرین! 🎊';conf()}else m.textContent='دوباره فکر کن 🤔';
 return ok}
function next(){i++;if(i<5)show();else end()}
function pick(b){if(lock)return;const ok=b.dataset.c=='1';
 b.classList.add(ok?'ok':'no');
 if(ok){lock=true;done(true);setTimeout(next,1400)}else done(false)}
function chk(){if(lock)return;const n=document.querySelectorAll('.c.on').length;
 if(n==S3[i].k){lock=true;done(true);setTimeout(next,1500)}else done(false)}
function end(){const last=st==2;
 A.innerHTML=`<h1>🏆 آفرین!</h1><div class="card"><div class="main stars">${'⭐'.repeat(Math.max(1,score))}</div><p class="name">${score} از ۵</p><button class="btn" onclick="${last?'home()':'go('+(st+1)+')'}">${last?'🔁 از اول':'مرحله بعد ▶'}</button></div>`;conf()}
home();
</script></body></html>
